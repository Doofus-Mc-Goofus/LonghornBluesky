<Page x:Class="Client.QuotePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
  d:DesignHeight="600" d:DesignWidth="540"
  Title="fuf" UseLayoutRounding="True" Unloaded="Page_Unloaded" FontFamily="/SegoeUI7/segoeui_0.ttf#Segoe UI" Foreground="{StaticResource readText}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" ScrollChanged="ScrollViewer_ScrollChanged">
        <Grid Margin="20">
            <Rectangle RadiusX="3" RadiusY="3" Stroke="{StaticResource dashUnderlayOutline}" Height="{Binding ActualHeight, ElementName=PostGrid, Mode=OneWay}" VerticalAlignment="Top" Fill="{StaticResource dashUnderlay2}">
                <Rectangle.Effect>
                    <DropShadowEffect ShadowDepth="5" Opacity="0.33" BlurRadius="10" Direction="270"/>
                </Rectangle.Effect>
            </Rectangle>
            <TabControl Background="{x:Null}" Padding="0" BorderThickness="0" VerticalAlignment="Top" Margin="0,-2,0,0">
                <TabItem Visibility="Collapsed">
                    <Grid x:Name="PostGrid" Width="{Binding ActualWidth, ElementName=PostStack, Mode=OneWay}" VerticalAlignment="Top">
                        <Image x:Name="Back" Source="/res/BackNormal.png" Stretch="None" HorizontalAlignment="Left" Margin="5,0,0,0" MouseDown="Back_MouseDown" MouseEnter="Back_MouseEnter" MouseLeave="Back_MouseLeave" MouseUp="Back_MouseUp"/>
                        <TextBlock Margin="52,9,0,0" Foreground="{StaticResource menuText}" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="/SegoeUI7/seguisb_0.ttf#Segoe UI Semibold" Text="Quotes"/>
                        <TextBlock x:Name="Number" Foreground="{StaticResource menuText}" Margin="52,27,0,11" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </Grid>
                </TabItem>
            </TabControl>
            <Grid x:Name="FeedGrid" Focusable="True" Margin="0,0,0,0">
                <TabControl x:Name="FeedTabControl" Padding="0" ScrollViewer.CanContentScroll="True" BorderThickness="0" Background="{x:Null}" Panel.ZIndex="1">
                    <TabItem x:Name="Tab" Padding="10,2,10,4" Margin="-2,-2,-2,0" BorderBrush="{StaticResource dashTabOutline}" Visibility="Collapsed">
                        <StackPanel x:Name="ReplyStack" Margin="0,71,0,0"/>
                    </TabItem>
                </TabControl>
                <Rectangle RadiusX="3" RadiusY="3" Stroke="{StaticResource dashUnderlayOutline}" Margin="0,73,0,0" Fill="{StaticResource dashUnderlay}">
                    <Rectangle.Effect>
                        <DropShadowEffect ShadowDepth="5" Opacity="0.33" BlurRadius="10" Direction="270"/>
                    </Rectangle.Effect>
                </Rectangle>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
