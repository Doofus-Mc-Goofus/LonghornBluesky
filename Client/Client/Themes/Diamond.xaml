<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="clr-namespace:System;assembly=mscorlib">
    <!-- General -->
    <s:String x:Key="PresentationFramework">pack://application:,,,/PresentationFramework.Aero;V4.0.0.0;31bf3856ad364e35;component/themes/aero.normalcolor.xaml</s:String>
    <SolidColorBrush x:Key="defText" Color="#FF0D467A"/>
    <SolidColorBrush x:Key="fadeText" Color="#FF9AA6B1"/>
    <SolidColorBrush x:Key="readText" Color="Black"/>
    <SolidColorBrush x:Key="profDescText" Color="Black"/>
    <SolidColorBrush x:Key="statText" Color="#FF5389BB"/>
    <SolidColorBrush x:Key="menuText" Color="#FF0D467A"/>
    <SolidColorBrush x:Key="menuText2" Color="#FF0D467A"/>
    <SolidColorBrush x:Key="textBoxPreview" Color="Gray"/>
    <LinearGradientBrush x:Key="dashUnderlay" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#CCDEF1FF"/>
        <GradientStop Color="#7FC7E6FF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="dashUnderlay2" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#CCDEF1FF"/>
        <GradientStop Color="#64C7E6FF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="dashUnderlayOutline" Color="#54E0F6FF"/>
    <SolidColorBrush x:Key="dashTabOutline" Color="#FF9FBDD2"/>

    <!-- Dashboard -->
    <BitmapImage x:Key="bg" UriSource="pack://application:,,,/res/themes/spartan.png"/>
    <s:Double x:Key="bgOpacity">0.5</s:Double>
    <LinearGradientBrush x:Key="bgUnderlay" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF6691B3"/>
        <GradientStop Color="#FFCFEAFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="menuBG" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFA2C1DA"/>
        <GradientStop Color="#FF9CBAD2" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="sideBarItemSelect" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#7FFFFFFF"/>
        <GradientStop Color="#7FFFFFFF" Offset="1"/>
        <GradientStop Color="#3FFFFFFF" Offset="0.654"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="sideBarItemSelectOutline" Color="#540D467A"/>

    <!-- Posts / Mini-Users / Feeds / Whatever -->
    <LinearGradientBrush x:Key="postBG" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#BFDCF0FF"/>
        <GradientStop Color="#7FCDE9FF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="quoteBG" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#BFEDF7FF"/>
        <GradientStop Color="#7FE0F1FF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="postOutline" Color="#FF9FBDD2"/>

    <!-- Toast -->
    <LinearGradientBrush x:Key="toastBG" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#CCCEEAFF"/>
        <GradientStop Color="#A8CDE9FF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="toastProgressEmpty" Color="#FFB1BED2"/>
    <SolidColorBrush x:Key="toastProgressFull" Color="#FF94C832"/>
    <LinearGradientBrush x:Key="toastProgressBorder" EndPoint="0,1">
        <GradientStop Color="#FFB2B2B2"/>
        <GradientStop Color="#FF8C8C8C" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="toastTextBG" Color="White"/>

    <!-- Icons and Images -->
    <BitmapImage x:Key="defPFP" UriSource="pack://application:,,,/res/usertile.png"/>
    <BitmapImage x:Key="defBan" UriSource="pack://application:,,,/res/Windows Vista Beta 1 Speech Tutorial.png"/>
    <BitmapImage x:Key="defFeed" UriSource="pack://application:,,,/res/FeedIcon.png"/>
    <BitmapImage x:Key="PFPBorder" UriSource="pack://application:,,,/res/PFPFrameSmal.png"/>
</ResourceDictionary>