<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="clr-namespace:System;assembly=mscorlib">
    <!-- General -->

    <!-- me when the .NET WPF PresentationFramework.Luna.dll-->
    <!-- <s:String x:Key="PresentationFramework">pack://application:,,,/PresentationFramework.Luna;V4.0.0.0;31bf3856ad364e35;component/themes/Luna.NormalColor.xaml</s:String> -->

    <s:String x:Key="PresentationFramework">pack://application:,,,/PresentationFramework.Aero;V4.0.0.0;31bf3856ad364e35;component/themes/aero.normalcolor.xaml</s:String>
    <SolidColorBrush x:Key="defText" Color="#FF024182"/>
    <SolidColorBrush x:Key="fadeText" Color="#FF8598AB"/>
    <SolidColorBrush x:Key="readText" Color="#F333"/>
    <SolidColorBrush x:Key="profDescText" Color="#FFF1F1F3"/>
    <SolidColorBrush x:Key="statText" Color="#FF6692BF"/>
    <SolidColorBrush x:Key="menuText" Color="#FFF1F1F3"/>
    <SolidColorBrush x:Key="menuText2" Color="#F556"/>
    <SolidColorBrush x:Key="textBoxPreview" Color="Gray"/>
    <LinearGradientBrush x:Key="dashUnderlay" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="White"/>
        <GradientStop Color="#FFD9E2ED" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="dashUnderlay2" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF73A0CB"/>
        <GradientStop Color="#FF5378BB" Offset="0.15"/>
        <GradientStop Color="#FF7093D4" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="dashUnderlayOutline" Color="#FF3463A9"/>
    <SolidColorBrush x:Key="dashTabOutline" Color="#FF5D728E"/>

    <!-- Dashboard -->
    <BitmapImage x:Key="bg" UriSource="pack://application:,,,/res/themes/Plex.png"/>
    <s:Double x:Key="bgOpacity">1</s:Double>
    <LinearGradientBrush x:Key="bgUnderlay" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF6691B3"/>
        <GradientStop Color="#FFCFEAFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="menuBG" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF6683CA"/>
        <GradientStop Color="#FF4A71B9" Offset="1"/>
        <GradientStop Color="#FF486BA9" Offset="0.15"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="sideBarItemSelect" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFE6F4FF"/>
        <GradientStop Color="#FFCDE5FF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="sideBarItemSelectOutline" Color="#FFB3D3FF"/>

    <!-- Posts / Mini-Users / Feeds / Whatever -->
    <LinearGradientBrush x:Key="postBG" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="White"/>
        <GradientStop Color="#FFD9E2ED" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="quoteBG" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="White"/>
        <GradientStop Color="#FFE4EAF3" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="postOutline" Color="#FF8ABEED"/>

    <!-- Toast -->
    <LinearGradientBrush x:Key="toastBG" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF6683CA"/>
        <GradientStop Color="#FF4A71B9" Offset="1"/>
        <GradientStop Color="#FF486BA9" Offset="0.15"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="toastProgressEmpty" Color="#FFB1C5D2"/>
    <SolidColorBrush x:Key="toastProgressFull" Color="#FF3287C8"/>
    <LinearGradientBrush x:Key="toastProgressBorder" EndPoint="0,1">
        <GradientStop Color="#FFB2B2B2"/>
        <GradientStop Color="#FF8C8C8C" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="toastTextBG" Color="White"/>

    <!-- Icons and Images -->
    <BitmapImage x:Key="defPFP" UriSource="pack://application:,,,/res/themes/PLEX_usertile.png"/>
    <BitmapImage x:Key="defBan" UriSource="pack://application:,,,/res/themes/Plex.png"/>
    <BitmapImage x:Key="defFeed" UriSource="pack://application:,,,/res/FeedIcon.png"/>
    <BitmapImage x:Key="PFPBorder" UriSource="pack://application:,,,/res/PFPFrameSmal.png"/>
</ResourceDictionary>