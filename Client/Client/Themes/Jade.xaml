<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="clr-namespace:System;assembly=mscorlib">
	<!-- General -->
	<s:String x:Key="PresentationFramework">pack://application:,,,/PresentationFramework.Aero;V4.0.0.0;31bf3856ad364e35;component/themes/aero.normalcolor.xaml</s:String>
    <SolidColorBrush x:Key="defText" Color="#FF2A1D69"/>
	<SolidColorBrush x:Key="fadeText" Color="Gray"/>
	<SolidColorBrush x:Key="readText" Color="#FF00021D"/>
	<SolidColorBrush x:Key="profDescText" Color="#FFF1F1F3"/>
    <SolidColorBrush x:Key="statText" Color="#FF665F88"/>
	<SolidColorBrush x:Key="menuText" Color="#FFF1F1F3"/>
    <SolidColorBrush x:Key="menuText2" Color="#FF2A1D69"/>
	<SolidColorBrush x:Key="textBoxPreview" Color="Gray"/>
	<LinearGradientBrush x:Key="dashUnderlay" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFDFCFF"/>
        <GradientStop Color="#FFEEEBF5" Offset="1"/>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="dashUnderlay2" EndPoint="0.5,1" StartPoint="0.5,0">
		<GradientStop Color="#FF595959"/>
        <GradientStop Color="#FF323232" Offset="0.2499"/>
        <GradientStop Color="#222" Offset="0.25"/>
        <GradientStop Color="#111" Offset="0.5"/>
        <GradientStop Color="#000" Offset="1"/>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="dashUnderlayOutline" Color="#FF919091"/>
	<SolidColorBrush x:Key="dashTabOutline" Color="#FF8D84A4"/>

	<!-- Dashboard -->
	<BitmapImage x:Key="bg" UriSource="pack://application:,,,/res/themes/jade1.png"/>
	<s:Double x:Key="bgOpacity">1</s:Double>
	<LinearGradientBrush x:Key="bgUnderlay" EndPoint="0.5,1" StartPoint="0.5,0">
		<GradientStop Color="#FF6691B3"/>
		<GradientStop Color="#FFCFEAFF" Offset="1"/>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="menuBG" EndPoint="0,0.5" StartPoint="1,0.5">
		<GradientStop Color="#FF5A6B7D"/>
		<GradientStop Color="#FF8597AF" Offset="0.33"/>
		<GradientStop Color="#FF8597AF" Offset="0.67"/>
		<GradientStop Color="#FF5A6B7D" Offset="1"/>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="sideBarItemSelect" EndPoint="0.5,1" StartPoint="0.5,0">
		<GradientStop Color="#FFE6E6FF"/>
        <GradientStop Color="#FFCDCEFF" Offset="1"/>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="sideBarItemSelectOutline" Color="#FFB8B3FF"/>

	<!-- Posts / Mini-Users / Feeds / Whatever -->
    <LinearGradientBrush x:Key="postBG" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#BFFDFCFF"/>
        <GradientStop Color="#7FF2EBF5" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="quoteBG" EndPoint="0.5,1" StartPoint="0.5,0">
		<GradientStop Color="#BFFFFFFF"/>
		<GradientStop Color="#7FEDEDED" Offset="1"/>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="postOutline" Color="#FFAFA6B7"/>

	<!-- Toast -->
	<LinearGradientBrush x:Key="toastBG" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF595959"/>
        <GradientStop Color="#FF323232" Offset="0.2499"/>
        <GradientStop Color="#222" Offset="0.25"/>
        <GradientStop Color="#111" Offset="0.5"/>
        <GradientStop Color="#000" Offset="1"/>
    </LinearGradientBrush>
	<SolidColorBrush x:Key="toastProgressEmpty" Color="#FFD2BFB1"/>
	<SolidColorBrush x:Key="toastProgressFull" Color="#FFC84732"/>
	<LinearGradientBrush x:Key="toastProgressBorder" EndPoint="0,1">
		<GradientStop Color="#FFB2B2B2"/>
		<GradientStop Color="#FF8C8C8C" Offset="1"/>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="toastTextBG" Color="White"/>

	<!-- Icons and Images -->
    <BitmapImage x:Key="defPFP" UriSource="pack://application:,,,/res/themes/LH_usertile.png"/>
	<BitmapImage x:Key="defBan" UriSource="pack://application:,,,/res/Windows Vista Beta 1 Speech Tutorial.png"/>
	<BitmapImage x:Key="defFeed" UriSource="pack://application:,,,/res/FeedIcon.png"/>
	<BitmapImage x:Key="PFPBorder" UriSource="pack://application:,,,/res/PFPFrameSmal.png"/>
</ResourceDictionary>