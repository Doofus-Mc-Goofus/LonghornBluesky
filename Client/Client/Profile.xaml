<Page x:Class="Client.Profile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="540"
      Title="Profile" UseLayoutRounding="True" Unloaded="Page_Unloaded" FontFamily="/SegoeUI7/segoeui_0.ttf#Segoe UI" Foreground="{StaticResource readText}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" ScrollChanged="ScrollViewer_ScrollChanged" FontFamily="/SegoeUI7/segoeui_0.ttf#Segoe UI">
        <Grid>
            <Grid x:Name="wrapper" VerticalAlignment="Top" Margin="20">
                <Image x:Name="Banner" Source="{StaticResource defBan}" VerticalAlignment="Top" Stretch="UniformToFill" Height="136" RenderOptions.BitmapScalingMode="Fant"/>
                <Grid x:Name="test" Margin="0,110,0,0" VerticalAlignment="Top" LayoutUpdated="Wrapper_LayoutUpdated">
                    <Rectangle x:Name="Rectangular" RadiusX="3" RadiusY="3" Stroke="{StaticResource dashUnderlayOutline}" MouseUp="Rectangle_MouseUp" Margin="0,25,0,0" Focusable="True" Fill="{StaticResource dashUnderlay2}">
                        <Rectangle.Effect>
                            <DropShadowEffect ShadowDepth="5" Opacity="0.33" BlurRadius="10" Direction="270"/>
                        </Rectangle.Effect>
                    </Rectangle>
                    <Image Source="/res/PFPShadow.png" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,38,0,0" Width="64" Height="29"/>
                    <Image x:Name="PFP" Source="{StaticResource defPFP}" VerticalAlignment="Top" HorizontalAlignment="Left" Width="52" Margin="16,14,0,0" RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="Fant">
                        <Image.OpacityMask>
                            <ImageBrush ImageSource="/res/PFPBorderLock.png"/>
                        </Image.OpacityMask>
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform AngleY="-5" AngleX="2.5"/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                    <Image x:Name="PFPFrame" Source="{StaticResource PFPBorder}" VerticalAlignment="Top" HorizontalAlignment="Left" Width="52" Margin="16,14,0,0" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform AngleY="-5" AngleX="2.5"/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                    <TextBlock x:Name="Username" Text="Loading..." FontSize="14" Margin="80,35,170,15" VerticalAlignment="Top" FontFamily="/SegoeUI7/seguisb_0.ttf#Segoe UI Semibold" Foreground="{StaticResource menuText}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="Fullname" Text="@" FontSize="11" Margin="80,55,170,0" VerticalAlignment="Top" FontFamily="/SegoeUI7/segoeuii_0.ttf#Segoe UI" Foreground="{StaticResource menuText}" TextTrimming="CharacterEllipsis"/>
                    <StackPanel x:Name="detailsStack" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,35,0,0" Orientation="Horizontal">
                        <Grid Margin="0,0,10,0">
                            <TextBlock x:Name="PostNum" Text="0" FontSize="14" VerticalAlignment="Top" FontFamily="/SegoeUI7/seguisb_0.ttf#Segoe UI Semibold" Foreground="{StaticResource menuText}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                            <TextBlock Text="posts" VerticalAlignment="Top" Foreground="{StaticResource menuText}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                        </Grid>
                        <Grid Margin="0,0,10,0">
                            <TextBlock x:Name="FollowersNum" Text="0" FontSize="14" VerticalAlignment="Top" FontFamily="/SegoeUI7/seguisb_0.ttf#Segoe UI Semibold" Foreground="{StaticResource menuText}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" MouseEnter="Label_MouseEnter" MouseLeave="Label_MouseLeave" Cursor="Hand" MouseUp="FollowersNum_MouseUp"/>
                            <TextBlock Text="followers" VerticalAlignment="Top" Foreground="{StaticResource menuText}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                        </Grid>
                        <Grid Margin="0,0,15,0">
                            <TextBlock x:Name="FolliwingNum" Text="0" FontSize="14" VerticalAlignment="Top" FontFamily="/SegoeUI7/seguisb_0.ttf#Segoe UI Semibold" Foreground="{StaticResource menuText}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" MouseEnter="Label_MouseEnter" MouseLeave="Label_MouseLeave" Cursor="Hand" MouseUp="FolliwingNum_MouseUp"/>
                            <TextBlock Text="following" VerticalAlignment="Top" Foreground="{StaticResource menuText}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                        </Grid>
                    </StackPanel>
                    <TextBlock x:Name="Bio" VerticalAlignment="Top" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" Margin="15,72,15,33" TextWrapping="Wrap" Foreground="{StaticResource profDescText}"/>

                    <TextBlock x:Name="ShowMore" Text="Show more..." VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" Margin="15,0,15,12" TextWrapping="Wrap" Foreground="{StaticResource menuText}" MouseEnter="Label_MouseEnter" MouseLeave="Label_MouseLeave" Panel.ZIndex="1" Cursor="Hand" MouseUp="ShowMore_MouseUp" Visibility="Collapsed"/>
                    <Button x:Name="EditProf" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,35,10" Content="Edit Profile" Padding="0,1,0,1" Width="80" Visibility="Collapsed" Click="EditProf_Click"/>
                    <Button x:Name="Follow" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,35,10" Content="Follow" Padding="16,1,16,1" Click="Follow_Click" Height="22"/>
                    <Button x:Name="Unblock" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,16,10" Content="Unblock" Padding="16,1,16,1" Click="BlockContext_Click" Visibility="Collapsed"/>
                    <Button x:Name="Overflow" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,15,10" Content="u" Width="20" FontFamily="Marlett" Height="22" FontSize="10" Click="Overflow_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy link to profile" Click="CopyLink_Click"/>
                                <MenuItem Header="Search posts"/>
                                <Separator/>
                                <MenuItem Header="Add to lists"/>
                                <MenuItem x:Name="MuteContext" Header="Mute account"/>
                                <MenuItem x:Name="BlockContext" Header="Block account" Click="BlockContext_Click"/>
                                <MenuItem x:Name="ReportContext" Header="Report account" Click="ReportContext_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>
            </Grid>
            <Grid x:Name="FeedGrid" Focusable="True" Margin="Infinity,271,20,20">
                <TabControl x:Name="FeedTabControl" Padding="0" ScrollViewer.CanContentScroll="True" BorderThickness="0" Background="{x:Null}" Panel.ZIndex="1" SelectedIndex="1">
                    <TabItem Header="Test" Padding="10,2,10,4" Margin="-2,-2,-2,0" BorderBrush="{StaticResource dashTabOutline}" Visibility="Collapsed">
                        <Grid/>
                    </TabItem>
                    <TabItem x:Name="Posts" Header="Posts" Padding="10,2,10,4" Margin="-2,-2,-2,0" BorderBrush="{StaticResource dashTabOutline}">
                        <StackPanel x:Name="PostsStack" VerticalAlignment="Top"/>
                    </TabItem>
                    <TabItem x:Name="Replies" Header="Replies" Padding="10,2,10,4" Margin="-2,-2,-2,0" BorderBrush="{StaticResource dashTabOutline}">
                        <StackPanel x:Name="RepliesStack" VerticalAlignment="Top"/>
                    </TabItem>
                    <TabItem x:Name="Media" Header="Media" Padding="10,2,10,4" Margin="-2,-2,-2,0" BorderBrush="{StaticResource dashTabOutline}">
                        <StackPanel x:Name="MediaStack" VerticalAlignment="Top"/>
                    </TabItem>
                    <TabItem x:Name="Likes" Header="Likes" Padding="10,2,10,4" Margin="-2,-2,-2,0" BorderBrush="{StaticResource dashTabOutline}" Visibility="Collapsed">
                        <StackPanel x:Name="LikesStack" VerticalAlignment="Top"/>
                    </TabItem>
                    <TabItem x:Name="Feeds" Header="Feeds" Padding="10,2,10,4" Margin="-2,-2,-2,0" BorderBrush="{StaticResource dashTabOutline}">
                        <StackPanel x:Name="FeedsStack" VerticalAlignment="Top"/>
                    </TabItem>
                    <TabItem x:Name="StarterPacks" Header="Starter Packs" Padding="10,2,10,4" Margin="-2,-2,-2,0" BorderBrush="{StaticResource dashTabOutline}">
                        <StackPanel x:Name="StarterPacksStack" VerticalAlignment="Top">
                            <Label HorizontalAlignment="Center" Content="It looks like there's nothing here" Foreground="{StaticResource menuText2}" Padding="10"/>
                        </StackPanel>
                    </TabItem>
                    <TabItem x:Name="Lists" Header="Lists" Padding="10,2,10,4" Margin="-2,-2,-2,0" BorderBrush="{StaticResource dashTabOutline}">
                        <StackPanel x:Name="ListsStack" VerticalAlignment="Top">
                            <Label HorizontalAlignment="Center" Content="It looks like there's nothing here" Foreground="{StaticResource menuText2}" Padding="10"/>
                        </StackPanel>
                    </TabItem>
                </TabControl>
                <Rectangle x:Name="rect" RadiusX="3" RadiusY="3" Stroke="{StaticResource dashUnderlayOutline}" MouseUp="Rectangle_MouseUp" Margin="0,26,0,0" Fill="{StaticResource dashUnderlay}">
                    <Rectangle.Effect>
                        <DropShadowEffect ShadowDepth="5" Opacity="0.33" BlurRadius="10" Direction="270"/>
                    </Rectangle.Effect>
                </Rectangle>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
