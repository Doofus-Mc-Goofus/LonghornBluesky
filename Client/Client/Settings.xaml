<Page x:Class="Client.Settings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="540"
      Title="Settings" UseLayoutRounding="True" SizeChanged="Page_SizeChanged" Unloaded="Page_Unloaded" FontFamily="/SegoeUI7/segoeui_0.ttf#Segoe UI" Foreground="{StaticResource menuText2}">
    <ScrollViewer x:Name="aegaegaegag" VerticalScrollBarVisibility="Auto">
        <Grid>
            <StackPanel x:Name="test" Margin="20" VerticalAlignment="Top">
                <Grid Height="52" Margin="0,0,0,20" VerticalAlignment="Top">
                    <Rectangle RadiusX="3" RadiusY="3" Stroke="{StaticResource dashUnderlayOutline}" Fill="{StaticResource dashUnderlay2}">
                        <Rectangle.Effect>
                            <DropShadowEffect ShadowDepth="5" Opacity="0.33" BlurRadius="10" Direction="270"/>
                        </Rectangle.Effect>
                    </Rectangle>
                    <Image x:Name="Back" Source="/res/BackDisabled.png" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" MouseDown="Back_MouseDown" MouseEnter="Back_MouseEnter" MouseLeave="Back_MouseLeave" MouseUp="Back_MouseUp" ToolTip="Back"/>
                    <TextBlock x:Name="PageTitle" Text="Settings" FontSize="14" Margin="57,0,20,0" VerticalAlignment="Center" FontFamily="/SegoeUI7/seguisb_0.ttf#Segoe UI Semibold" Foreground="{StaticResource menuText}" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </StackPanel>
            <Grid x:Name="homie" Margin="20,92,20,20">
                <Rectangle x:Name="rect" RadiusX="3" RadiusY="3" Stroke="{StaticResource dashUnderlayOutline}" MouseUp="Rectangle_MouseUp" Fill="{StaticResource dashUnderlay}">
                    <Rectangle.Effect>
                        <DropShadowEffect ShadowDepth="5" Opacity="0.33" BlurRadius="10" Direction="270"/>
                    </Rectangle.Effect>
                </Rectangle>
                <StackPanel Margin="0,10,0,10">
                    <StackPanel x:Name="Secret" Visibility="Collapsed">
                        <Grid x:Name="Account" Height="32" Margin="0,0,0,2" MouseEnter="Account_MouseEnter" MouseLeave="Account_MouseLeave" MouseUp="Account_MouseUp">
                            <Rectangle x:Name="Account_BG" Margin="2,0,2,0" Stroke="{StaticResource sideBarItemSelectOutline}" RadiusY="3" RadiusX="3" Visibility="Collapsed" Fill="{StaticResource sideBarItemSelect}"/>
                            <Image Source="/res/ProfileIcon.png" Height="24" HorizontalAlignment="Left" Margin="14,0,0,0"/>
                            <Label x:Name="Account_Text" Foreground="{StaticResource menuText2}" Content="User Accounts" VerticalContentAlignment="Center" Margin="42,0,0,0"/>
                        </Grid>
                        <Grid x:Name="Privacy" Height="32" Margin="0,0,0,2" MouseEnter="Privacy_MouseEnter" MouseLeave="Privacy_MouseLeave" MouseUp="Privacy_MouseUp">
                            <Rectangle x:Name="Privacy_BG" Margin="2,0,2,0" Stroke="{StaticResource sideBarItemSelectOutline}" RadiusY="3" RadiusX="3" Visibility="Collapsed" Fill="{StaticResource sideBarItemSelect}"/>
                            <Image Source="/res/FilterIcon.png" Height="24" HorizontalAlignment="Left" Margin="14,0,0,0"/>
                            <Label x:Name="Privacy_Text" Foreground="{StaticResource menuText2}" Content="Security" VerticalContentAlignment="Center" Margin="42,0,0,0"/>
                        </Grid>
                        <Grid x:Name="Moderation" Height="32" Margin="0,0,0,2" MouseEnter="Moderation_MouseEnter" MouseLeave="Moderation_MouseLeave" MouseUp="Moderation_MouseUp">
                            <Rectangle x:Name="Moderation_BG" Margin="2,0,2,0" Stroke="{StaticResource sideBarItemSelectOutline}" RadiusY="3" RadiusX="3" Visibility="Collapsed" Fill="{StaticResource sideBarItemSelect}"/>
                            <Image Source="/res/WindowIcon.png" Height="24" HorizontalAlignment="Left" Margin="14,0,0,0"/>
                            <Label x:Name="Moderation_Text" Foreground="{StaticResource menuText2}" Content="Moderation" VerticalContentAlignment="Center" Margin="42,0,0,0"/>
                        </Grid>
                        <Grid x:Name="SettingsContent" Height="32" Margin="0,0,0,2" MouseEnter="CAM_MouseEnter" MouseLeave="CAM_MouseLeave" MouseUp="CAM_MouseUp">
                            <Rectangle x:Name="Content_BG" Margin="2,0,2,0" Stroke="{StaticResource sideBarItemSelectOutline}" RadiusY="3" RadiusX="3" Visibility="Collapsed" Fill="{StaticResource sideBarItemSelect}"/>
                            <Image Source="/res/NewspaperIcon.ico" Height="24" HorizontalAlignment="Left" Margin="14,0,0,0"/>
                            <Label x:Name="Content_Text" Foreground="{StaticResource menuText2}" Content="Content and Media" VerticalContentAlignment="Center" Margin="42,0,0,0"/>
                        </Grid>
                    </StackPanel>
                    <Grid x:Name="Personalization" Height="32" Margin="0,0,0,2" MouseEnter="Personalization_MouseEnter" MouseLeave="Personalization_MouseLeave" MouseUp="Personalization_MouseUp">
                        <Rectangle x:Name="Personalization_BG" Margin="2,0,2,0" Stroke="{StaticResource sideBarItemSelectOutline}" RadiusY="3" RadiusX="3" Visibility="Collapsed" Fill="{StaticResource sideBarItemSelect}"/>
                        <Image Source="/res/PersonalizationIcon.png" Height="24" HorizontalAlignment="Left" Margin="14,0,0,0"/>
                        <Label x:Name="Personalization_Text" Foreground="{StaticResource menuText2}" Content="Appearance and Personalization" VerticalContentAlignment="Center" Margin="42,0,0,0"/>
                    </Grid>
                    <StackPanel x:Name="Secret2" Visibility="Collapsed">
                        <Grid x:Name="Accessibility" Height="32" Margin="0,0,0,2" MouseEnter="Accessibility_MouseEnter" MouseLeave="Accessibility_MouseLeave" MouseUp="Accessibility_MouseUp">
                            <Rectangle x:Name="Accessibility_BG" Margin="2,0,2,0" Stroke="{StaticResource sideBarItemSelectOutline}" RadiusY="3" RadiusX="3" Visibility="Collapsed" Fill="{StaticResource sideBarItemSelect}"/>
                            <Image Source="/res/AccessibilityIcon.png" Height="24" HorizontalAlignment="Left" Margin="14,0,0,0"/>
                            <Label x:Name="Accessibility_Text" Foreground="{StaticResource menuText2}" Content="Accessibility" VerticalContentAlignment="Center" Margin="42,0,0,0"/>
                        </Grid>
                        <Grid x:Name="SettingsLanguage" Height="32" Margin="0,0,0,2" MouseEnter="Language_MouseEnter" MouseLeave="Language_MouseLeave" MouseUp="Language_MouseUp">
                            <Rectangle x:Name="Language_BG" Margin="2,0,2,0" Stroke="{StaticResource sideBarItemSelectOutline}" RadiusY="3" RadiusX="3" Visibility="Collapsed" Fill="{StaticResource sideBarItemSelect}"/>
                            <Image Source="/res/RegionIcon.png" Height="24" HorizontalAlignment="Left" Margin="14,0,0,0"/>
                            <Label x:Name="Language_Text" Foreground="{StaticResource menuText2}" Content="Language and Region" VerticalContentAlignment="Center" Margin="42,0,0,0"/>
                        </Grid>
                    </StackPanel>
                    <Grid x:Name="Help" Height="32" Margin="0,0,0,2" MouseEnter="Help_MouseEnter" MouseLeave="Help_MouseLeave" MouseUp="Help_MouseUp">
                        <Rectangle x:Name="Help_BG" Margin="2,0,2,0" Stroke="{StaticResource sideBarItemSelectOutline}" RadiusY="3" RadiusX="3" Visibility="Collapsed" Fill="{StaticResource sideBarItemSelect}"/>
                        <Image Source="/res/HelpIconHD.png" Height="24" HorizontalAlignment="Left" Margin="14,0,0,0"/>
                        <Label x:Name="Help_Text" Foreground="{StaticResource menuText2}" Content="Help" VerticalContentAlignment="Center" Margin="42,0,0,0"/>
                    </Grid>
                    <Grid x:Name="About" Height="32" Margin="0,0,0,2" MouseEnter="About_MouseEnter" MouseLeave="About_MouseLeave" MouseUp="About_MouseUp">
                        <Rectangle x:Name="About_BG" Margin="2,0,2,0" Stroke="{StaticResource sideBarItemSelectOutline}" RadiusY="3" RadiusX="3" Visibility="Collapsed" Fill="{StaticResource sideBarItemSelect}"/>
                        <Image Source="/res/logomondy.png" Height="24" HorizontalAlignment="Left" Margin="14,0,0,0"/>
                        <Label x:Name="About_Text" Foreground="{StaticResource menuText2}" Content="About" VerticalContentAlignment="Center" Margin="42,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Grid>
            <Frame x:Name="PageFrame" Margin="0,0,0,0" NavigationUIVisibility="Hidden" Visibility="Collapsed"/>
        </Grid>
    </ScrollViewer>
</Page>
