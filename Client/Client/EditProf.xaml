<Page x:Class="Client.EditProf"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="540"
      Title="Edit Profile" UseLayoutRounding="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" FontFamily="/SegoeUI7/segoeui_0.ttf#Segoe UI" Foreground="{StaticResource readText}">
        <Grid x:Name="wrapper" Margin="20">
            <Image x:Name="Banner" Source="{StaticResource defBan}" VerticalAlignment="Top" Stretch="UniformToFill" Height="136"/>
            <Grid x:Name="test" Margin="0,110,0,0" VerticalAlignment="Top">
                <Rectangle x:Name="bingus" VerticalAlignment="Top" Focusable="True"/>
                <Rectangle x:Name="Rectangular" RadiusX="3" RadiusY="3" Stroke="{StaticResource dashUnderlayOutline}" MouseUp="Rectangle_MouseUp" Margin="0,25,0,0" Fill="{StaticResource dashUnderlay2}">
                    <Rectangle.Effect>
                        <DropShadowEffect ShadowDepth="5" Opacity="0.33" BlurRadius="10" Direction="270"/>
                    </Rectangle.Effect>
                </Rectangle>
                <Image Source="/res/PFPShadow.png" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,38,0,0" Width="64" Height="29"/>
                <Image x:Name="PFP" Source="{StaticResource defPFP}" VerticalAlignment="Top" HorizontalAlignment="Left" Width="52" Margin="16,14,0,0" RenderTransformOrigin="0.5,0.5">
                    <Image.OpacityMask>
                        <ImageBrush ImageSource="/res/PFPBorderLock.png"/>
                    </Image.OpacityMask>
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform AngleY="-5" AngleX="2.5"/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
                <Image x:Name="PFPFrame" Source="{StaticResource PFPBorder}" VerticalAlignment="Top" HorizontalAlignment="Left" Width="52" Margin="16,14,0,0" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform AngleY="-5" AngleX="2.5"/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
                <StackPanel Margin="15,75,15,15" VerticalAlignment="Top">
                    <Label Content="Display Name:" Padding="0,0,0,5" FontFamily="/SegoeUI7/seguisb_0.ttf#Segoe UI Semibold" MouseUp="Rectangle_MouseUp" Foreground="{StaticResource menuText}"/>
                    <TextBox x:Name="Username" Text="Display Name" Foreground="{StaticResource textBoxPreview}" GotKeyboardFocus="Username_GotKeyboardFocus" LostKeyboardFocus="Username_LostKeyboardFocus"/>
                    <Label Content="Description:" Padding="0,15,0,5" Foreground="{StaticResource menuText}" FontFamily="/SegoeUI7/seguisb_0.ttf#Segoe UI Semibold" MouseUp="Rectangle_MouseUp"/>
                    <TextBox x:Name="Bio" TextWrapping="Wrap" Text="Tell us a bit about yourself" Height="86" Foreground="{StaticResource textBoxPreview}" LostKeyboardFocus="Bio_LostKeyboardFocus" GotKeyboardFocus="Bio_GotKeyboardFocus" AcceptsReturn="True"/>
                    <Grid Margin="0,10,0,0">
                        <Label x:Name="Error" Content="Error message." Padding="0" Foreground="#FFB33C3C" FontFamily="/SegoeUI7/seguisb_0.ttf#Segoe UI Semibold" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="Save" VerticalAlignment="Bottom" HorizontalAlignment="Right" Content="Save" Padding="0,1,0,1" Width="70" Click="Save_Click" Margin="0,0,10,0"/>
                            <Button x:Name="Cancel" VerticalAlignment="Bottom" HorizontalAlignment="Right" Content="Cancel" Padding="0,1,0,1" Width="70" Click="Cancel_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
